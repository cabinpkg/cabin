# Unified-diff and git-preamble tokens for apply_patch, and the paths
# of the harness's tree (PATCH_TREE in src/lib.rs).
git="diff --git a/"
git_b=" b/"
index="index "
range=".."
mode=" 100644"
exec_mode=" 100755"
link_mode=" 120000"
new_file="new file mode 100644"
deleted_file="deleted file mode 100644"
old_mode="old mode 100644"
new_mode="new mode 100755"
old="--- a/"
new="+++ b/"
dev_null_old="--- /dev/null"
dev_null_new="+++ /dev/null"
hunk="@@ -"
hunk_new=" +"
hunk_end=" @@"
no_newline="\\ No newline at end of file"
rename="rename from "
copy="copy from "
binary="GIT binary patch"
binary_files="Binary files "
cr="\x0d"
cabin_toml="cabin.toml"
header="include/demo.h"
c_source="src/demo.c"
cpp_source="src/main.cpp"
