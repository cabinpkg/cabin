# Tar header fields, the seeds' top directory, and the paths an
# extraction must refuse.
ustar_magic="ustar\x0000"
gnu_magic="ustar  \x00"
type_regular="0"
type_hardlink="1"
type_symlink="2"
type_character="3"
type_block="4"
type_directory="5"
type_fifo="6"
type_gnu_longname="L"
type_gnu_longlink="K"
type_pax="x"
type_pax_global="g"
gnu_longlink_name="././@LongLink"
pax_path="path="
pax_linkpath="linkpath="
pax_size="size="
top_dir="pkg/"
traversal="../"
absolute="/"
