{
    // Hosted registry service (see README.md). One configuration, no
    // wrangler environments: the registry runs under its final production
    // names while remaining closed to allowlisted maintainers and labeled
    // as under development. Launch is a data/policy event, not an
    // infrastructure cutover (docs/runbook.md, "Launch checklist").
    "name": "api",
    "main": "build/index.js",
    "compatibility_date": "2026-07-09",
    "workers_dev": false,
    // Version URLs (and aliased ones) would be a second origin outside
    // the custom domain; omitting this keeps whatever the dashboard has.
    "preview_urls": false,
    // worker-build is a prerequisite on PATH, installed once at the
    // version CI pins (README.md, "Development"); every wrangler dev
    // and deploy runs this, except with CABIN_WORKER_PREBUILT set: CI
    // bundles and deploys a build it already has (docs/runbook.md,
    // "Deploy credential boundary").
    "build": {
        "command": "test -n \"$CABIN_WORKER_PREBUILT\" || worker-build --release"
    },
    "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
    },
    // Secrets, set via `wrangler secret put <NAME>` (never in this file):
    // GITHUB_CLIENT_SECRET, SESSION_SECRET, ANALYTICS_API_TOKEN (Account
    // Analytics Read; the budget cron degrades gracefully without it),
    // ALERT_RECIPIENT_EMAIL (the one address the cron's alert mail goes to;
    // docs/runbook.md, "Alerts"),
    // and optionally WEBSITE_DEPLOY_HOOK (the website's Workers Builds
    // deploy hook, POSTed when its package pages fall behind the catalog).
    // CACHE_PURGE_TOKEN (the zone's Cache Purge) is required from the
    // deploy that adds INDEX_ORIGIN to `vars` (docs/runbook.md, "Upload
    // lifecycle").
    // GITHUB_CLIENT_ID is a public OAuth identifier and lives in `vars`.
    // The breaker budgets BUDGET_R2_STORAGE_BYTES, BUDGET_R2_CLASS_A_MONTH,
    // BUDGET_WORKERS_REQ_DAY, and BUDGET_D1_ROWS_READ_DAY have in-code
    // defaults (src/breaker.rs) and only need `vars` entries to override.
    // BUDGET_R2_CLASS_B_MONTH is different: unset, Class B is monitored
    // against a warn-only default; setting it is what arms the read-side
    // breaker (docs/runbook.md, "Read budgets and paid-plan
    // activation") - do not set it before that procedure.
    // The governor's hard R2 limits (GOVERNOR_R2_CLASS_{A,B}_*_MONTH;
    // src/governor.rs) follow the same in-code-default pattern, with one
    // deliberate difference: a var that is set but unparsable fails
    // closed to a ZERO limit - a typo in a hard spending cap blocks its
    // pool loudly instead of silently reverting to a default
    // (docs/runbook.md, "The cost governor").
    // One Worker, one role per hostname (docs/remote-registry.md, "One
    // role per hostname"): the registry custom domain serves only the
    // machine read plane, and the website origin (cabinpkg.com) serves
    // /login, /callback (plus the claim flow's /callback/claim),
    // /claim/*, and /api/* via the zone routes below.
    "routes": [
        { "pattern": "registry.cabinpkg.com", "custom_domain": true },
        // Path routes are more specific than the website Worker's
        // domain, so they win on these paths and only these paths.
        // /callback needs the trailing * because a pattern without
        // one never matches a URL carrying a query string (GitHub
        // redirects to /callback?code=...&state=...); it also covers
        // the claim flow's /callback/claim. /login stays exact so
        // /login/denied keeps rendering on the website; /claim/* is
        // the claim-initiate route (one path segment, the scope).
        { "pattern": "cabinpkg.com/api/*", "zone_name": "cabinpkg.com" },
        { "pattern": "cabinpkg.com/login", "zone_name": "cabinpkg.com" },
        { "pattern": "cabinpkg.com/callback*", "zone_name": "cabinpkg.com" },
        { "pattern": "cabinpkg.com/claim/*", "zone_name": "cabinpkg.com" }
    ],
    // The budget-breaker evaluation (src/glue/mod.rs `scheduled`
    // runs it on exactly this expression and nothing on any other);
    // ~100 invocations/day, negligible against the free limits.
    "triggers": { "crons": ["*/15 * * * *"] },
    "vars": {
        // The website origin: config.json's `api` field, the
        // WWW-Authenticate login_url, OAuth redirects, and the
        // quota details' usage URLs all derive from it. The index
        // stays on the registry custom domain declared in
        // `routes` above; no var names it because no code reads it.
        "WEB_ORIGIN": "https://cabinpkg.com",
        // Comma-separated numeric GitHub user ids allowed to sign
        // in; empty means nobody. Not a secret.
        // 26405363 = ken-matsui
        "ALLOWED_GITHUB_IDS": "26405363",
        // Comma-separated exact scope names exempt from the claim
        // flow's skeleton confusability refusal (docs/runbook.md,
        // "Name fidelity knobs"); empty means no exemptions. Never
        // bypasses reserved names or claim permanence.
        "CLAIM_SKELETON_EXEMPT_SCOPES": "",
        // Client id of the GitHub OAuth app (callback
        // https://cabinpkg.com/callback). Public, not a secret;
        // the matching GITHUB_CLIENT_SECRET is a secret.
        "GITHUB_CLIENT_ID": "Ov23liAgmw27EQavKC8H",
        // Account tag for the GraphQL Analytics queries. Not a
        // secret (it is in every dashboard URL).
        "CF_ACCOUNT_ID": "9c71e2a985a7a7e4746bae45cabc14b1",
        // The one workflow allowed to deliver verdicts and to mint the
        // verify-scoped exchange token: both take only a GitHub
        // Actions OIDC JWT whose claims match all four pins
        // (src/trustpub.rs, VerifierPins). Pins, not secrets - the
        // JWT's signature is the credential. The ids are the immutable
        // numeric GitHub identifiers (renaming the owner or repository
        // changes neither). 35998702 = cabinpkg, 119684778 =
        // cabinpkg/cabin.
        "VERIFIER_REPOSITORY_OWNER_ID": "35998702",
        "VERIFIER_REPOSITORY_ID": "119684778",
        "VERIFIER_WORKFLOW_FILENAME": "registry-verify.yml",
        "VERIFIER_GIT_REF": "refs/heads/main",
        // The operator identity backing the verifier arm's mint, by
        // its immutable numeric GitHub account id (26405363 =
        // ken-matsui). The baseline migration seeds this identity, so
        // it exists from apply time; a no-row refusal means this var
        // and the migration seed disagree.
        "VERIFIER_BACKING_ACCOUNT_ID": "26405363"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "registry",
            "database_id": "7d9e918c-825c-45b2-8d7e-2c8dbf0d7279",
            "migrations_dir": "migrations"
        }
    ],
    // One bucket per role. UPLOADS and DOWNLOAD_LOGS expire their
    // objects after fourteen days (docs/runbook.md, "First-time provisioning").
    "r2_buckets": [
        { "binding": "ARCHIVES", "bucket_name": "registry-archives" },
        { "binding": "UPLOADS", "bucket_name": "registry-uploads" },
        { "binding": "DOWNLOAD_LOGS", "bucket_name": "registry-download-logs" },
        { "binding": "INDEX", "bucket_name": "registry-index" }
    ],
    // The cron's alert mail (src/alerts.rs; docs/runbook.md, "Alerts"):
    // this binding sends from the one sender and from no other. The
    // recipient is the ALERT_RECIPIENT_EMAIL secret, so its address is not in
    // this file.
    "send_email": [
        {
            "name": "NOTIFY_EMAIL",
            "allowed_sender_addresses": ["noreply@cabinpkg.com"]
        }
    ],
    // The cost governor: one named SQLite-backed Durable Object is the
    // serialized authority for the hard R2 budgets (src/governor.rs,
    // src/governor_do.rs; docs/runbook.md, "The cost governor").
    // SQLite-backed classes are what the free plan supports, hence
    // new_sqlite_classes; the migration tag ships with the same deploy
    // that first references the class.
    "durable_objects": {
        "bindings": [{ "name": "GOVERNOR", "class_name": "Governor" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Governor"] }],
    // Admission control for the public endpoints that spend work before
    // any credential is read: the two OIDC endpoints (the
    // trusted-publishing exchange PUT and the verdict PATCH), which can
    // be made to fetch GitHub's JWKS (src/trustpub.rs, the unknown-kid
    // refetch), and the session mint PUT, which spends a GitHub
    // check-token call. Two budgets: OIDC_LIMITER is the per-client-IP
    // gate spent before any JWT or GitHub work (glue/bearer/mod.rs
    // `oidc_admission`; its 429 carries a Retry-After of the period
    // below), and JWKS_LIMITER is the single-key global bound
    // on cache-bypass JWKS refetches (trustpub.rs `GithubJwks`).
    // `cargo check-deploy` requires both bindings; the worker fails
    // closed without them. Counters are per-colo, not global - the
    // dashboard WAF rule stays as the outer layer (docs/runbook.md,
    // "Zone rate limiting (WAF)").
    "unsafe": {
        "bindings": [
            {
                "name": "OIDC_LIMITER",
                "type": "ratelimit",
                "namespace_id": "1001",
                "simple": { "limit": 60, "period": 60 }
            },
            {
                "name": "JWKS_LIMITER",
                "type": "ratelimit",
                "namespace_id": "1002",
                "simple": { "limit": 6, "period": 60 }
            }
        ]
    }
}
