#!/bin/sh
# The `gh` both sides of tests/await_deploy_differential.rs reach: this
# directory goes first on their PATH, so the shell fixture and the port
# drive the same stand-in over the same canned service.
#
# This is a test asset, not repository automation, so AGENTS.md's "no new
# shell tooling" rule is not what governs it: the seam has to be an
# executable file named `gh` that a bash script can find on PATH, and a
# script is the smallest thing that is one. Porting it to Rust would mean
# a second binary in the crate that only prints canned text.
#
# Every call appends its full argv to $FAKE_GH_LOG - one line, arguments
# separated by tabs, which is safe only because none of the four
# requests contains a tab or a newline. That log is the request-parity
# artifact: the suite asserts the two sides produced identical logs, so
# a reordered or reworded argv fails there rather than here.
#
# A response lives at $FAKE_GH_DIR/<kind>.<n>, where <n> is the ordinal
# of that kind's call within the run, falling back to $FAKE_GH_DIR/<kind>
# for scenarios whose answer does not change between iterations. Its
# first line is the exit status; the rest is stdout, already projected
# the way `gh --jq` would print it. The ordinal is counted out of the log
# rather than a counter file, so the state lives in exactly one place.
set -u

printf '%s\t' "$@" >>"$FAKE_GH_LOG"
printf '\n' >>"$FAKE_GH_LOG"

argv="$*"
case $argv in
    */actions/runs/*/jobs\?per_page=100*)
        run=${argv#*/actions/runs/}
        run=${run%%/jobs*}
        kind=deploy-$run
        key=/actions/runs/$run/jobs
        ;;
    *status=success*)
        kind=candidates
        key=status=success
        ;;
    *head_sha=*)
        kind=runs
        key=head_sha=
        ;;
    *'branch=main&per_page=100'*)
        kind=pending
        key='branch=main&per_page=100'
        ;;
    *)
        printf 'fake gh: unrecognized request: %s\n' "$argv" >&2
        exit 111
        ;;
esac

ordinal=$(grep -cF "$key" "$FAKE_GH_LOG")
response=$FAKE_GH_DIR/$kind.$ordinal
[ -f "$response" ] || response=$FAKE_GH_DIR/$kind
if [ ! -f "$response" ]; then
    printf 'fake gh: no canned %s response for call %s\n' "$kind" "$ordinal" >&2
    exit 112
fi

tail -n +2 "$response"
exit "$(head -n 1 "$response")"
