deploy_step() {
  gh api "repos/$GITHUB_REPOSITORY/actions/runs/$1/jobs?per_page=100" \
    --jq '[.jobs[] | select(.name == "deploy-registry") | .steps[] | select(.name == "Deploy") | .conclusion][0]'
}
for _ in $(seq 1 90); do
  git fetch --quiet origin main || true
  # Satisfied: a successful main run containing this SHA
  # whose Deploy step actually ran and succeeded.
  # per_page=100: successive skipped-Deploy successes (a
  # migration awaiting its by-hand apply green-lights every
  # subsequent run) must not push the qualifying run out of
  # the scanned window - the same-SHA fallback below cannot
  # break the tie for a merely-successful run, so a buried
  # candidate would idle the loop into its ceiling.
  if candidates=$(gh api \
    "repos/$GITHUB_REPOSITORY/actions/workflows/registry.yml/runs?branch=main&status=success&per_page=100" \
    --jq '.workflow_runs[] | "\(.id) \(.head_sha)"'); then
    while read -r rid rsha; do
      [ -n "$rid" ] || continue
      git merge-base --is-ancestor "$GITHUB_SHA" "$rsha" 2>/dev/null || continue
      if [ "$(deploy_step "$rid" || echo transient)" = "success" ]; then
        echo "registry deploy $rid (head $rsha) contains this SHA"
        exit 0
      fi
    done <<< "$candidates"
  fi
  if ! runs=$(gh api \
    "repos/$GITHUB_REPOSITORY/actions/workflows/registry.yml/runs?head_sha=$GITHUB_SHA" \
    --jq '.workflow_runs'); then
    echo "transient API error listing Registry runs; retrying"
    sleep 40
    continue
  fi
  if [ "$(printf '%s' "$runs" | jq 'length')" -eq 0 ]; then
    echo "no Registry run for this SHA; the deployed worker is already current"
    exit 0
  fi
  conclusion=$(printf '%s' "$runs" | jq -r '.[0].conclusion')
  if [ "$conclusion" = "failure" ] || [ "$conclusion" = "cancelled" ]; then
    # Terminal only when nothing pending could still satisfy
    # the ancestor gate: a queued or in-progress run whose
    # head contains this SHA (a rerun, or main already
    # carrying the fix) delivers the deploy on a later
    # iteration, while failing here would strand this run -
    # registry-only pushes never retrigger ports-publish.
    if ! pending=$(gh api \
      "repos/$GITHUB_REPOSITORY/actions/workflows/registry.yml/runs?branch=main&per_page=100" \
      --jq '.workflow_runs[] | select(.status != "completed") | .head_sha'); then
      echo "transient API error listing pending Registry runs; retrying"
      sleep 40
      continue
    fi
    descendant_pending=false
    while read -r psha; do
      [ -n "$psha" ] || continue
      if git merge-base --is-ancestor "$GITHUB_SHA" "$psha" 2>/dev/null; then
        descendant_pending=true
        break
      fi
    done <<< "$pending"
    if [ "$descendant_pending" = true ]; then
      echo "Registry run for this SHA concluded '$conclusion'; a pending run containing it may still deploy; waiting"
      sleep 40
      continue
    fi
    echo "Registry run for this SHA concluded '$conclusion' and no deploy containing it has landed; not publishing against a stale worker" >&2
    exit 1
  fi
  sleep 40
done
echo "timed out waiting for a registry deploy containing this SHA" >&2
exit 1
