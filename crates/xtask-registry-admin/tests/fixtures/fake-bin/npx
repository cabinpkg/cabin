#!/bin/sh
# The `npx` both sides of tests/migrate_differential.rs reach: this
# directory goes first on their PATH, so `lib.sh`'s
# `wrangler() { npx --yes wrangler@4.112.0 "$@"; }` and the port's spawn
# of the same argv drive one stand-in over one canned database.
#
# This is a test asset, not repository automation, so AGENTS.md's "no new
# shell tooling" rule is not what governs it: the seam has to be an
# executable file named `npx` that a bash script finds on PATH, and a
# script is the smallest thing that is one. Porting it to Rust would mean
# a second binary in the crate that only prints canned JSON.
#
# Every call appends its full argv to $FAKE_NPX_LOG as ONE line,
# arguments separated by tabs. The `--command` argument carries a real
# newline (migrate.sh wraps the has-table query across two lines), so
# newlines are mapped to RS - 0x1e - before the record terminator is
# written; nothing in the corpus contains an RS or a tab, so the mapping
# is injective and one call stays one line. That log is the
# request-parity artifact: the suite asserts the two sides produced
# identical logs, so a port that reflowed the SQL, reordered its
# arguments or skipped a call fails there rather than here.
#
# Each record starts with WHERE the call was made, because wrangler
# resolves D1 and R2 through the `wrangler.jsonc` of its working
# directory: a side that ran the right argv in the wrong tree would
# reach a different database while looking identical in every other
# byte this suite compares. The two sides' roots are different scratch
# directories, so the field cannot be the path; it is the presence of
# the marker file the harness drops in the root it means, which also
# sidesteps the symlinked temporary directories `pwd -P` would have to
# be reconciled against.
#
# Responses live at $FAKE_NPX_DIR/<kind>.<phase>, falling back to
# $FAKE_NPX_DIR/<kind> where the answer does not change across the apply.
# The first line is the exit status; the rest is stdout, in wrangler's
# own `--json` shape, because the shell pipes it through `node -e`
# projections that index it (out[0].results[0].n, out[0].results[].name).
#
# The phase is the whole of the fake database's state: it starts
# `before`, and applying migrations flips it to `after`, so the
# post-apply re-read of the applied set can answer differently from the
# read that preceded it. $FAKE_NPX_DIR is per side, so one side's apply
# never leaks into the other's reads.
set -u

if [ -f ./.differential-root ]; then
    printf '[root]\t' >>"$FAKE_NPX_LOG"
else
    printf '[elsewhere]\t' >>"$FAKE_NPX_LOG"
fi
printf '%s\t' "$@" | tr '\n' '\036' >>"$FAKE_NPX_LOG"
printf '\n' >>"$FAKE_NPX_LOG"

argv="$*"
case $argv in
    *sqlite_master*) kind=has-table ;;
    *'SELECT name FROM d1_migrations'*) kind=names ;;
    *'d1 migrations apply'*) kind=apply ;;
    *)
        printf 'fake npx: unrecognized request: %s\n' "$argv" >&2
        exit 111
        ;;
esac

phase=$(cat "$FAKE_NPX_DIR/phase")
response=$FAKE_NPX_DIR/$kind.$phase
[ -f "$response" ] || response=$FAKE_NPX_DIR/$kind
if [ ! -f "$response" ]; then
    printf 'fake npx: no canned %s response in phase %s\n' "$kind" "$phase" >&2
    exit 112
fi

# Before the response is served, not after: the apply's own exit status
# is the scenario's, and a failed apply still ran against the database.
if [ "$kind" = apply ]; then
    printf 'after' >"$FAKE_NPX_DIR/phase"
fi

tail -n +2 "$response"
exit "$(head -n 1 "$response")"
