set -euo pipefail
if [ -z "$REGISTRY_VERIFY_TOKEN" ]; then
  echo "REGISTRY_VERIFY_TOKEN is not configured" >&2
  exit 1
fi

# The privileged token travels to exactly two destinations,
# both of which must be https - curl has no cleartext guard,
# unlike the Rust clients.
case "$REGISTRY_ORIGIN" in
  https://*) ;;
  *) echo "REGISTRY_ORIGIN must be https, got: $REGISTRY_ORIGIN" >&2; exit 1 ;;
esac
case "$EXPECTED_API_ORIGIN" in
  https://*) ;;
  *) echo "EXPECTED_API_ORIGIN must be https, got: $EXPECTED_API_ORIGIN" >&2; exit 1 ;;
esac

# One hostname, one role: the index origin serves config.json
# and the artifacts; the admin API lives on the `api` origin
# config.json declares (docs/remote-registry.md). A missing
# field fails the run - fail-safe, versions stay pending.
config=$(curl -fsS -H "authorization: Bearer $REGISTRY_VERIFY_TOKEN" \
  "$REGISTRY_ORIGIN/config.json")
api_origin=$(jq -er '.api' <<<"$config")
if [ "$api_origin" != "$EXPECTED_API_ORIGIN" ]; then
  echo "config.json api does not match the pinned verifier API origin" >&2
  exit 1
fi

list=$(curl -fsS -H "authorization: Bearer $REGISTRY_VERIFY_TOKEN" \
  "$api_origin/api/v1/admin/versions?status=pending")
count=$(jq -r '.versions | length' <<<"$list")
if [ "$count" -eq 0 ]; then
  echo "nothing pending"
  exit 0
fi
echo "$count pending version(s)"

# The corpus for the name advisories, fetched once per run.
# A failed fetch fails the run under `set -e` - without the
# corpus no advisory can run, and proceeding without them
# could verify a confusable name (fail-safe: everything
# stays pending).
corpus=$(mktemp)
curl -fsS -H "authorization: Bearer $REGISTRY_VERIFY_TOKEN" \
  -o "$corpus" "$api_origin/api/v1/admin/packages"

# One version failing operationally (it stays pending) must
# not starve the rest of the list; failures are aggregated
# and fail the run at the end.
verifier=target/release/cabin-registry-verify
failures=0
# Aggregate seconds this run may spend downloading upstream
# archives.  `--max-time` bounds one transfer, but the admin
# listing is deterministically sorted, so a publisher with
# several slow upstream hosts could otherwise pin the same
# early-sorting versions to the front of every cron pass and
# starve everything behind them.  When the budget runs out,
# remaining provenance versions verify without their
# upstream file (structure/consistency still render
# verdicts; provenance-clean ones stay pending), and the
# shuffled order below rotates which versions get the
# budget across runs.
upstream_budget=300
for i in $(seq 0 $((count - 1)) | shuf); do
  entry=$(jq -c ".versions[$i]" <<<"$list")
  name=$(jq -r '.name' <<<"$entry")
  version=$(jq -r '.version' <<<"$entry")
  revision=$(jq -r '.revision' <<<"$entry")
  checksum=$(jq -r '.checksum' <<<"$entry")
  published_at=$(jq -r '.published_at' <<<"$entry")

  workdir=$(mktemp -d)
  printf '%s' "$entry" >"$workdir/entry.json"

  # Name advisories run before the download - they need no
  # bytes, so an abstained version costs a listing entry per
  # cron pass, never a re-download. Abstain renders no
  # verdict and is deliberately NOT a failure: the version
  # stays pending until the stuck-pending alert summons the
  # operator (registry/docs/runbook.md, "Verification
  # pipeline").
  if ! advice_json=$("$verifier" --name-advisories "$workdir/entry.json" "$corpus"); then
    echo "$name@$version: name advisories failed operationally; leaving it pending" >&2
    failures=$((failures + 1))
    rm -rf "$workdir"
    continue
  fi
  advice=$(jq -r '.advice' <<<"$advice_json")
  case "$advice" in
    proceed) ;;
    abstain)
      findings=$(jq -r '.findings | join(",")' <<<"$advice_json")
      echo "$name@$version: abstain ($findings); leaving it pending for operator review"
      rm -rf "$workdir"
      continue
      ;;
    *)
      echo "$name@$version: unknown advice '$advice'; leaving it pending" >&2
      failures=$((failures + 1))
      rm -rf "$workdir"
      continue
      ;;
  esac

  # The scoped name `<scope>/<name>` nests the artifact
  # directory (`artifacts/<scope>/<name>/`) while the
  # filename flattens the `/` to `-` and ends in the row's
  # packaging revision
  # (`<scope>-<name>-<version>-<revision>.zip`), matching the
  # registry's read route: each revision of a version has its
  # own URL, so this downloads exactly the bytes the listing
  # entry names.
  stem=${name//\//-}
  if ! curl -fsS -H "authorization: Bearer $REGISTRY_VERIFY_TOKEN" \
    -o "$workdir/archive.zip" \
    "$REGISTRY_ORIGIN/artifacts/$name/$stem-$version-$revision.zip"; then
    echo "$name@$version: archive download failed; leaving it pending" >&2
    failures=$((failures + 1))
    rm -rf "$workdir"
    continue
  fi

  # Upstream provenance: when the stored metadata declares
  # a pinned upstream archive, download it and hand it to
  # the verifier.  The URL is publisher-controlled, so the
  # privileged token is never sent with this request, and
  # curl is pinned to https on the initial request and on
  # every redirect; integrity comes from the verifier's
  # SHA-256 pin.  Destination-IP filtering (private/
  # loopback ranges, per redirect hop and DNS answer) is
  # deliberately not attempted: plain curl cannot enforce
  # it, this job runs only on ephemeral GitHub-hosted
  # runners with no privileged network position, and the
  # response bytes are never disclosed - the digest pin
  # reduces any reachable endpoint to an equality oracle.
  # Revisit before ever moving this job to a self-hosted
  # runner.  Publish validation already rejected
  # non-https URLs, so a cleartext URL here is corrupt
  # registry state - an operational failure, never a
  # verdict.  A failed download must not reject the package
  # (a flaky upstream host is not the publisher's fault),
  # but the verifier still runs without the upstream file:
  # its first two passes can reject a bad archive on their
  # own, and a version whose provenance could not be
  # checked exits operationally and stays pending.  The
  # timeouts bound how long one version can stall the run;
  # the 256 MiB size cap bounds runner disk and is part of
  # the documented provenance contract (docs/manifest.md),
  # and the extraction is bounded by `cabin-artifact`'s
  # built-in client caps.  Rejecting on a size-cap abort is
  # deliberately avoided: curl's judgment can reflect a
  # server-misreported length, and a false rejection is
  # terminal while pending is recoverable.
  upstream_args=()
  upstream_url=$(jq -r '.metadata.upstream.url // empty' <<<"$entry")
  if [ -n "$upstream_url" ]; then
    case "$upstream_url" in
      https://*) ;;
      *)
        echo "$name@$version: stored upstream url is not https; leaving it pending" >&2
        failures=$((failures + 1))
        rm -rf "$workdir"
        continue
        ;;
    esac
    if [ "$upstream_budget" -le 0 ]; then
      echo "$name@$version: upstream download budget exhausted; verifying without it" >&2
    else
      # One transfer may use at most the remaining budget
      # (never more than 120 s), and every attempt charges
      # at least one whole second, so the aggregate bound
      # holds even against sub-second transfers.
      transfer_cap=$((upstream_budget < 120 ? upstream_budget : 120))
      download_started=$SECONDS
      if curl -fsSL --proto '=https' --proto-redir '=https' \
        --connect-timeout 10 --max-time "$transfer_cap" --max-filesize 268435456 \
        -o "$workdir/upstream-archive" "$upstream_url"; then
        upstream_args=(--upstream "$workdir/upstream-archive")
      else
        echo "$name@$version: upstream archive download failed; verifying without it" >&2
      fi
      spent=$((SECONDS - download_started))
      [ "$spent" -lt 1 ] && spent=1
      upstream_budget=$((upstream_budget - spent))
    fi
  fi

  if ! result=$("$verifier" "$workdir/archive.zip" "$workdir/entry.json" "${upstream_args[@]}"); then
    echo "$name@$version: verifier failed operationally; leaving it pending" >&2
    failures=$((failures + 1))
    rm -rf "$workdir"
    continue
  fi
  verdict=$(jq -r '.verdict' <<<"$result")
  reason=""
  case "$verdict" in
    verified)
      body=$(jq -cn --arg checksum "$checksum" --arg published_at "$published_at" \
        '{verdict: "verified", checksum: $checksum, published_at: $published_at}')
      ;;
    rejected)
      reason=$(jq -r '.reasons | join(",")' <<<"$result")
      body=$(jq -cn --arg reason "$reason" --arg checksum "$checksum" --arg published_at "$published_at" \
        '{verdict: "rejected", reason: $reason, checksum: $checksum, published_at: $published_at}')
      ;;
    *)
      echo "$name@$version: unknown verdict '$verdict'; leaving it pending" >&2
      failures=$((failures + 1))
      rm -rf "$workdir"
      continue
      ;;
  esac

  # A 409 here means the row changed since the listing (a
  # republish or a competing verdict); the next run sees
  # the replacement.
  if ! curl -fsS -X PATCH \
    -H "authorization: Bearer $REGISTRY_VERIFY_TOKEN" \
    -H "content-type: application/json" \
    --data "$body" -o /dev/null \
    "$api_origin/api/v1/admin/versions/$name/$version"; then
    echo "$name@$version: verdict PATCH failed; leaving it pending" >&2
    failures=$((failures + 1))
    rm -rf "$workdir"
    continue
  fi
  echo "$name@$version: $verdict${reason:+ ($reason)}"
  rm -rf "$workdir"
done

if [ "$failures" -gt 0 ]; then
  echo "$failures version(s) hit operational failures and stay pending" >&2
  exit 1
fi
