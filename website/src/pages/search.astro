---
import IconTile from "../components/IconTile.astro";
import SearchResults from "../components/SearchResults.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
    DEFAULT_SEARCH_PAGE,
    DEFAULT_SEARCH_PER_PAGE,
    REGISTRY_PRIVATE_ALPHA,
} from "../lib/constants";
import { getCatalog, getPackageSearchIndex } from "../lib/packages";
import {
    getSearchCountLabel,
    getSearchTitle,
    paginateItems,
} from "../lib/search";

const available = getCatalog().provenance.state === "available";
const packages = getPackageSearchIndex();
const initialPagination = paginateItems(
    packages,
    DEFAULT_SEARCH_PAGE,
    DEFAULT_SEARCH_PER_PAGE,
);
---

<BaseLayout
    title="All packages"
    canonicalPath="/search"
    contentClass="container-shell max-w-4xl py-10"
    typeahead={false}
>
    <section class="mb-8">
        <div class="flex items-start gap-4">
            <IconTile name="search" size="lg" />
            <div>
                <h1
                    id="search-title"
                    class="text-3xl font-bold tracking-tight md:text-4xl"
                >
                    {getSearchTitle("")}
                </h1>
                {
                    available ? (
                        <p id="result-count" class="mt-2 text-ink-muted">
                            {getSearchCountLabel(initialPagination, "")}
                        </p>
                    ) : (
                        <p id="catalog-unavailable" class="mt-2 text-ink-muted">
                            {REGISTRY_PRIVATE_ALPHA}
                        </p>
                    )
                }
            </div>
        </div>
    </section>

    {available && <SearchResults pagination={initialPagination} />}
</BaseLayout>
