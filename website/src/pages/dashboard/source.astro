---
// The source viewer: browse the exact files of a published, verified
// version, read straight from the stored archive via the session source
// route (api/src/source.rs). The static build carries only the
// skeleton; source.ts picks the package and version from the
// ?name=&version= query and does all fetching and zip parsing
// client-side.
import AccountShell from "../../components/account/AccountShell.astro";
import SourceViewer from "../../components/SourceViewer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Source"
    description="Browse the files of a published version on the Cabin registry."
    canonicalPath="/dashboard/source"
    contentClass="container-shell max-w-6xl py-10"
>
    <AccountShell title="Source">
        <header class="mb-6">
            <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span
                    class="font-mono text-lg font-semibold text-steel"
                    data-source-package></span>
                <code class="font-mono text-sm text-ink-muted" data-source-version
                ></code>
            </p>
            <p class="mt-1 text-xs text-ink-faint">
                The published archive's files, exactly as the registry stores
                them.
            </p>
        </header>
        <SourceViewer />
    </AccountShell>
    {/* Outside the AccountShell slot on purpose: the slot renders into
        the shell's hidden content section, which only source.ts
        reveals - a noscript inside it would never show. No /api/ links
        here: the page is not on the progressive-independence account
        allowlist, and the source route only answers ranged reads.
        Inline tags keep their neighboring spaces on the same line -
        the build's HTML compression drops whitespace-only text nodes
        at text/element boundaries, fusing the words around them. */}
    <noscript>
        <div class="mt-6 rounded-md border border-line bg-night-raised px-6 py-5">
            <p class="text-ink-muted">
                Browsing an archive here needs JavaScript: the viewer
                reads the published archive from the registry in your
                browser. Without it, the <code class="font-mono text-sm">cabin</code> CLI
                still fetches a package's exact published archive as an
                ordinary dependency, and the curated foundation ports
                link their upstream source archives from the <a
                    href="/search"
                    class="font-medium text-steel">package index</a>.
            </p>
        </div>
    </noscript>
</BaseLayout>
