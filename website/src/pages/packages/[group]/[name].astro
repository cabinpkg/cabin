---
import PackageDetailView from "../../../components/package/PackageDetailView.astro";
import {
    getPackageHref,
    getPackageStaticPaths,
    type PackageRecord,
    type PackageVersionListItem,
} from "../../../lib/packages";

interface Props {
    pack: PackageRecord;
    versions: PackageVersionListItem[];
}

export async function getStaticPaths() {
    return getPackageStaticPaths();
}

const { pack, versions } = Astro.props;
---

<PackageDetailView
    pack={pack}
    versions={versions}
    currentVersion={null}
    title={`${pack.name} (latest)`}
    description={pack.description || `Cabin package ${pack.name}`}
    canonicalPath={getPackageHref(pack.name)}
/>
