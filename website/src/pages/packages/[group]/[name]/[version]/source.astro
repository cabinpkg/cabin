---
// A version's public source viewer: the files of its published archive,
// range-read by src/scripts/source.ts straight from the registry's
// static archive host, with no session and no credentials. Generated
// from the catalog like the package pages, so it exists exactly for the
// versions the registry serves.
import SourceViewer from "../../../../../components/SourceViewer.astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import {
    getPackageArchiveUrl,
    getPackageSourceHref,
    getPackageVersionHref,
    getPackageVersionStaticPaths,
    type PackageRecord,
} from "../../../../../lib/packages";

interface Props {
    pack: PackageRecord;
}

export async function getStaticPaths() {
    return getPackageVersionStaticPaths();
}

const { pack } = Astro.props;
---

<BaseLayout
    title={`${pack.name} (v${pack.version}) files`}
    description={`The published files of Cabin package ${pack.name} v${pack.version}`}
    canonicalPath={getPackageSourceHref(pack.name, pack.version)}
    contentClass="container-shell max-w-6xl py-10"
>
    <header class="mb-6">
        <h1 class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <a
                href={getPackageVersionHref(pack.name, pack.version)}
                class="font-mono text-lg font-semibold text-steel hover:text-steel-bright"
                >{pack.name}</a
            >
            <code class="font-mono text-sm text-ink-muted">v{pack.version}</code>
        </h1>
        <p class="mt-1 text-xs text-ink-faint">
            The published archive's files, exactly as the registry stores
            them.
        </p>
    </header>
    <p class="text-sm text-ink-muted" aria-live="polite" data-source-status hidden>
    </p>
    {/* Hidden until source.ts has read the archive's directory. */}
    <div data-source-archive={getPackageArchiveUrl(pack)} hidden>
        <SourceViewer />
    </div>
    {/* Inline tags keep their neighboring spaces on the same line - the
        build's HTML compression drops whitespace-only text nodes at
        text/element boundaries, fusing the words around them. */}
    <noscript>
        <div class="mt-6 rounded-md border border-line bg-night-raised px-6 py-5">
            <p class="text-ink-muted">
                Browsing an archive here needs JavaScript: the viewer
                reads the published archive from the registry in your
                browser. Without it, the <code class="font-mono text-sm">cabin</code> CLI
                still fetches a package's exact published archive as an
                ordinary dependency.
            </p>
        </div>
    </noscript>
</BaseLayout>
