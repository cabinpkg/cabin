---
import type { PackageRecord } from "../../lib/packages";
import Icon from "../Icon.astro";
import Card from "../ui/Card.astro";
import CodeBlock from "../ui/CodeBlock.astro";

interface Props {
    package: PackageRecord;
}

const { package: pack } = Astro.props;
// Scoped registry names contain "/", so the dependency key must be quoted to
// stay a single TOML key.
const installSnippet = `[dependencies]\n"${pack.name}" = "=${pack.version}"`;
---

<Card class="p-6">
    <div class="mb-4 flex items-center gap-2">
        <Icon name="download" class="h-5 w-5 text-pine" />
        <h2 class="text-xl font-bold">Installation</h2>
    </div>
    <p class="mb-3 leading-7 text-ink-muted">Add this to your <code class="rounded-sm bg-night-lifted px-1.5 py-0.5 font-mono text-sm text-ink">cabin.toml</code>:</p>
    <CodeBlock code={installSnippet} />
    <p class="mt-3 text-sm leading-6 text-ink-muted">
        <code class="rounded-sm bg-night-lifted px-1.5 py-0.5 font-mono text-xs text-ink">cabin-ports/*</code>
        dependencies resolve from the Cabin registry out of the box &mdash;
        verified packages download without an account or token, and
        <code class="rounded-sm bg-night-lifted px-1.5 py-0.5 font-mono text-xs text-ink">cabin login</code>
        is only needed to publish.  These libraries are also available today
        as bundled foundation ports &mdash; see <a
            href="/docs/foundation-ports/"
            class="font-medium text-steel hover:text-steel-bright">the
            foundation ports docs</a>.
    </p>
</Card>
