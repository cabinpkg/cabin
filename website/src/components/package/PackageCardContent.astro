---
import type { PackageListItem } from "../../lib/types";
import Icon from "../Icon.astro";
import Card from "../ui/Card.astro";

interface Props {
    package?: PackageListItem;
}

const { package: item } = Astro.props;

const packageName = item?.name ?? "";
const version = item?.version ?? "";
const href = item?.href ?? null;
const isLinkable = Boolean(href);
---

<Card
    href={href}
    class:list={[isLinkable && "group", "block p-5"]}
    ariaLabel={isLinkable && packageName ? `View ${packageName}` : undefined}
>
    <div class="flex min-w-0 items-center gap-3">
        <div class="icon-surface">
            <Icon name="cube" class="h-5 w-5" />
        </div>
        <div class="min-w-0">
            <h2
                class:list={[
                    "truncate text-lg font-bold text-ink transition",
                    isLinkable && "group-hover:text-steel-bright",
                ]}
                data-package-field="name"
            >
                {packageName}
            </h2>
            <p class="mt-1 font-mono text-sm text-ink-faint">
                v<span data-package-field="version">{version}</span>
            </p>
        </div>
    </div>
</Card>
