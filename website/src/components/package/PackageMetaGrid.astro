---
import type { PackageRecord, PackageVersionListItem } from "../../lib/packages";
import Icon from "../Icon.astro";
import Badge from "../ui/Badge.astro";
import Card from "../ui/Card.astro";
import PackageVersions from "./PackageVersions.astro";

interface Props {
    package: PackageRecord;
    versions: PackageVersionListItem[];
    currentVersion: string | null;
}

const { package: pack, versions, currentVersion } = Astro.props;
---

<aside class="space-y-6">
    <Card class="p-6">
        <h2 class="mb-4 text-lg font-bold">Package Info</h2>
        <dl class="space-y-4">
            <div class="flex items-center justify-between gap-4">
                <dt class="flex items-center gap-2 text-ink-muted">
                    <Icon name="box" class="h-4 w-4" />
                    Versions
                </dt>
                <dd>
                    <Badge tone="muted">{versions.length}</Badge>
                </dd>
            </div>
            <div class="flex items-center justify-between gap-4">
                <dt class="flex items-center gap-2 text-ink-muted">
                    <Icon name="branch" class="h-4 w-4" />
                    Dependencies
                </dt>
                <dd>
                    {/* Normal-kind edges, system and cfg-conditioned ones
                        included; dev edges appear only in the
                        Dependencies card. */}
                    <Badge tone="muted">
                        {
                            pack.manifest.dependencies.filter(
                                (dependency) => dependency.kind === "normal",
                            ).length
                        }
                    </Badge>
                </dd>
            </div>
        </dl>
    </Card>

    {/* A single-version card would only repeat the h1 and the count
        row above; it appears once there is somewhere to navigate. */}
    {
        versions.length > 1 && (
            <PackageVersions
                versions={versions}
                currentVersion={currentVersion}
            />
        )
    }

    {
        pack.upstream && (
            <Card class="p-6">
                <h2 class="mb-4 text-lg font-bold">Provenance</h2>
                <p class="mb-4 text-sm leading-6 text-ink-muted">
                    This package is Cabin's packaging of pinned, unmodified
                    upstream sources; the upstream project is developed
                    independently and does not publish it.
                </p>
                <dl class="space-y-4">
                    <div class="flex items-center justify-between gap-4">
                        <dt class="flex items-center gap-2 text-ink-muted">
                            <Icon name="tag" class="h-4 w-4" />
                            Upstream version
                        </dt>
                        <dd class="font-mono text-sm font-semibold text-ink">
                            {pack.upstream.version}
                        </dd>
                    </div>
                    <div>
                        <dt class="mb-1 flex items-center gap-2 text-ink-muted">
                            <Icon name="download" class="h-4 w-4" />
                            Source archive
                        </dt>
                        <dd class="break-all text-sm">
                            <a
                                href={pack.upstream.archiveUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-medium text-steel hover:text-steel-bright"
                            >
                                {pack.upstream.archiveUrl}
                            </a>
                        </dd>
                    </div>
                    <div>
                        <dt class="mb-1 flex items-center gap-2 text-ink-muted">
                            <Icon name="lock" class="h-4 w-4" />
                            Checksum
                        </dt>
                        <dd class="break-all font-mono text-xs text-ink-faint">
                            {pack.upstream.checksum}
                        </dd>
                    </div>
                </dl>
            </Card>
        )
    }
</aside>
