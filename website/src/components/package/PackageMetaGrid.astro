---
import {
    formatEdition,
    formatRelativeTime,
    stringifyValue,
} from "../../lib/format";
import {
    normalizePackageMetadata,
    type PackageRecord,
} from "../../lib/packages";
import Icon from "../Icon.astro";
import Badge from "../ui/Badge.astro";
import Card from "../ui/Card.astro";
import ExternalLink from "../ui/ExternalLink.astro";

interface Props {
    package: PackageRecord;
    versionCount: number;
}

const { package: pack, versionCount } = Astro.props;
const metadata = normalizePackageMetadata(pack.metadata);
const publishedAt = stringifyValue(pack.published_at);
const license = stringifyValue(pack.license);
const licenseHref = license
    ? `https://choosealicense.com/licenses/${license.toLowerCase()}/`
    : undefined;
const editionLabel = formatEdition(pack.edition);
---

<aside class="space-y-6">
    <Card class="p-6">
        <h2 class="mb-4 text-lg font-bold">Package Info</h2>
        <dl class="space-y-4">
            <div class="flex items-center justify-between gap-4">
                <dt class="flex items-center gap-2 text-ink-muted">
                    <Icon name="box" class="h-4 w-4" />
                    Versions
                </dt>
                <dd>
                    <Badge tone="muted">{versionCount}</Badge>
                </dd>
            </div>
            <div class="flex items-center justify-between gap-4">
                <dt class="flex items-center gap-2 text-ink-muted">
                    <Icon name="branch" class="h-4 w-4" />
                    Dependencies
                </dt>
                <dd>
                    <Badge tone="muted">{metadata.dependencyCount}</Badge>
                </dd>
            </div>
            <div class="flex items-center justify-between gap-4">
                <dt class="flex items-center gap-2 text-ink-muted">
                    <Icon name="calendar" class="h-4 w-4" />
                    Published
                </dt>
                <dd class="text-sm font-semibold text-ink">
                    {publishedAt ? formatRelativeTime(publishedAt) : "Unknown"}
                </dd>
            </div>
            <div class="flex items-center justify-between gap-4">
                <dt class="flex items-center gap-2 text-ink-muted">
                    <Icon name="gavel" class="h-4 w-4" />
                    License
                </dt>
                <dd>
                    {
                        licenseHref ? (
                            <a
                                href={licenseHref}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-sm font-semibold text-steel hover:text-steel-bright"
                            >
                                {license}
                            </a>
                        ) : (
                            <span class="text-sm text-ink-faint">Unknown</span>
                        )
                    }
                </dd>
            </div>
            {
                editionLabel && (
                    <div class="flex items-center justify-between gap-4">
                        <dt class="flex items-center gap-2 text-ink-muted">
                            <Icon name="code" class="h-4 w-4" />
                            Edition
                        </dt>
                        <dd>
                            <Badge>{editionLabel}</Badge>
                        </dd>
                    </div>
                )
            }
        </dl>
    </Card>

    {
        pack.upstream && (
            <Card class="p-6">
                <h2 class="mb-4 text-lg font-bold">Provenance</h2>
                <p class="mb-4 text-sm leading-6 text-ink-muted">
                    This package is Cabin's packaging of pinned, unmodified
                    upstream sources; the upstream project is developed
                    independently and does not publish it.
                </p>
                <dl class="space-y-4">
                    <div class="flex items-center justify-between gap-4">
                        <dt class="flex items-center gap-2 text-ink-muted">
                            <Icon name="tag" class="h-4 w-4" />
                            Upstream version
                        </dt>
                        <dd class="font-mono text-sm font-semibold text-ink">
                            {pack.upstream.version}
                        </dd>
                    </div>
                    {
                        pack.version !== pack.upstream.version && (
                            <div class="flex items-center justify-between gap-4">
                                <dt class="flex items-center gap-2 text-ink-muted">
                                    <Icon name="box" class="h-4 w-4" />
                                    Cabin packaging
                                </dt>
                                <dd class="font-mono text-sm font-semibold text-ink">
                                    {pack.version}
                                </dd>
                            </div>
                        )
                    }
                    <div>
                        <dt class="mb-1 flex items-center gap-2 text-ink-muted">
                            <Icon name="download" class="h-4 w-4" />
                            Source archive
                        </dt>
                        <dd class="break-all text-sm">
                            <a
                                href={pack.upstream.archiveUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-medium text-steel hover:text-steel-bright"
                            >
                                {pack.upstream.archiveUrl}
                            </a>
                        </dd>
                    </div>
                    <div>
                        <dt class="mb-1 flex items-center gap-2 text-ink-muted">
                            <Icon name="lock" class="h-4 w-4" />
                            SHA-256
                        </dt>
                        <dd class="break-all font-mono text-xs text-ink-faint">
                            {pack.upstream.sha256}
                        </dd>
                    </div>
                </dl>
            </Card>
        )
    }

    <Card class="p-6">
        <h2 class="mb-4 text-lg font-bold">Links</h2>
        <div class="space-y-3">
            {
                metadata.links.homepage && (
                    <ExternalLink
                        href={metadata.links.homepage}
                        icon="home"
                        class="w-full justify-start"
                    >
                        Homepage
                    </ExternalLink>
                )
            }
            {
                metadata.links.documentation && (
                    <ExternalLink
                        href={metadata.links.documentation}
                        icon="book"
                        class="w-full justify-start"
                    >
                        Documentation
                    </ExternalLink>
                )
            }
            {
                metadata.links.repository && (
                    <ExternalLink
                        href={metadata.links.repository}
                        icon="branch"
                        class="w-full justify-start"
                    >
                        {pack.upstream ? "Upstream repository" : "Repository"}
                    </ExternalLink>
                )
            }
            {
                !metadata.links.homepage &&
                    !metadata.links.documentation &&
                    !metadata.links.repository && (
                        <p class="text-sm text-ink-faint">
                            This package has no links.
                        </p>
                    )
            }
        </div>
    </Card>
</aside>
