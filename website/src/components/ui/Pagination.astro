---
import { getPaginationItems } from "../../lib/pagination";

interface Props {
    query: string;
    page: number;
    perPage: number;
    totalPages: number;
    id?: string;
    class?: string;
}

const {
    query,
    page,
    perPage,
    totalPages,
    id,
    class: className = "",
} = Astro.props;

const paginationItems = getPaginationItems({
    query,
    currentPage: page,
    perPage,
    totalPages,
});
---

{/* Always rendered: search.ts needs the element when ?perPage splits a
    single static page. */}
<nav
    id={id}
    class:list={[
        "mt-8 flex flex-wrap justify-center gap-2",
        className,
        totalPages <= 1 && "hidden",
    ]}
    aria-label="Package result pages"
>
    {
        totalPages > 1 &&
            paginationItems.map((item) =>
                item.type === "ellipsis" ? (
                    <span class="px-2 py-2 text-ink-faint">...</span>
                ) : item.disabled ? (
                    <span
                        class="page-link page-link-disabled"
                        aria-disabled="true"
                    >
                        {item.label}
                    </span>
                ) : (
                    <a
                        href={item.href}
                        class:list={[
                            "page-link",
                            item.current && "page-link-current",
                        ]}
                        aria-current={item.current ? "page" : undefined}
                    >
                        {item.label}
                    </a>
                ),
            )
    }
</nav>
